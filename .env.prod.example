# Web
WEB_PORT=80
BACKEND_PORT=8080

# App
APP_NAME=rubedo-backend
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_SCAFFOLD_LOGIN_PASSWORD=disabled-in-production

# PostgreSQL
POSTGRES_DB=rubedo
POSTGRES_USER=rubedo
POSTGRES_PASSWORD=replace-with-strong-db-password

# Redis
REDIS_DB=0
REDIS_PASSWORD=


# Meilisearch
MEILISEARCH_MASTER_KEY=replace-with-strong-meilisearch-master-key

# Optional image tags override (defaults are shiokou/redgal-*)
# FRONTEND_IMAGE=shiokou/redgal-frontend:latest
# BACKEND_IMAGE=shiokou/redgal-backend:latest

# Optional Bangumi API overrides
# BANGUMI_API_BASE_URL=https://api.bgm.tv/v0
# BANGUMI_API_USER_AGENT=RubedoForum/2026 (+https://your-domain; contact: admin@your-domain)
