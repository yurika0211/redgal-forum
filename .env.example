# Canonical env template for the whole project (root-level).
# Backend now loads this .env first, then falls back to backend/.env for compatibility.

# App
APP_NAME=rubedo-backend
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Auth
AUTH_JWT_SECRET=replace-me
AUTH_ALLOW_DEBUG_HEADERS=false
AUTH_ALLOW_SCAFFOLD_LOGIN=true
AUTH_SCAFFOLD_LOGIN_PASSWORD=dev-password-change-me

# Ports (docker-compose host bindings)
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
MEILISEARCH_PORT=7701

# Service credentials
POSTGRES_DB=rubedo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_DB=0
REDIS_PASSWORD=
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
MEILI_ENV=development
MEILISEARCH_MASTER_KEY=masterKey

# Backend direct-run endpoints (used when running `go run ./cmd/api`)
POSTGRES_DSN=postgres://postgres:postgres@127.0.0.1:5433/rubedo?sslmode=disable
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# Bangumi API (optional)
BANGUMI_API_BASE_URL=https://api.bgm.tv/v0
BANGUMI_API_USER_AGENT=RubedoForum/2026 (+https://localhost; contact: admin@rubedo.local)
